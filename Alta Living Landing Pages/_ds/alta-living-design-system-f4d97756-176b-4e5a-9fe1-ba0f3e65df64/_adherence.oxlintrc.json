{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/core/**",
              "components/layout/**",
              "components/property/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:League Gothic|Bricolage Grotesque|IBM Plex Mono|Cedarville Cursive|Instrument Sans))/i]",
        "message": "Font not provided by the design system. Available: League Gothic, Bricolage Grotesque, IBM Plex Mono, Cedarville Cursive, Instrument Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|children|pad|style|key|ref|className|style|children)$/]",
        "message": "<ArchPanel> doesn't accept that prop. Declared props: title, action, children, pad, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|shape|iconStart|iconEnd|block|disabled|justify|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, shape, iconStart, iconEnd, block, disabled, justify, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hard|hard-invert|solid|outline|ghost|link)$/]",
        "message": "<Button> variant must be one of 'hard' | 'hard-invert' | 'solid' | 'outline' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|pill)$/]",
        "message": "<Button> shape must be one of 'square' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<CTABand> doesn't accept that prop. Declared props: title, subtitle, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|tone|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCell> doesn't accept that prop. Declared props: icon, title, children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCell'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|sage|peach|lilac|butter)$/]",
        "message": "<FeatureCell> tone must be one of 'blue' | 'sage' | 'peach' | 'lilac' | 'butter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|speed|tone|style|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: items, speed, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rust|ink|paper)$/]",
        "message": "<Marquee> tone must be one of 'rust' | 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavCapsule'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<NavCapsule> doesn't accept that prop. Declared props: items, active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PatternField'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|opacity|fadeIn|style|key|ref|className|style|children)$/]",
        "message": "<PatternField> doesn't accept that prop. Declared props: src, size, opacity, fadeIn, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinboardNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|x|y|rotate|text|key|ref|className|style|children)$/]",
        "message": "<PinboardNote> doesn't accept that prop. Declared props: id, x, y, rotate, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinnedPhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|width|height|rotate|seed|caption|style|key|ref|className|style|children)$/]",
        "message": "<PinnedPhoto> doesn't accept that prop. Declared props: src, alt, width, height, rotate, seed, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PropertyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|title|hook|location|beds|availability|price|unit|tone|onView|style|key|ref|className|style|children)$/]",
        "message": "<PropertyCard> doesn't accept that prop. Declared props: src, alt, title, hook, location, beds, availability, price, unit, tone, onView, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PropertyCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|sage|peach|lilac|butter)$/]",
        "message": "<PropertyCard> tone must be one of 'blue' | 'sage' | 'peach' | 'lilac' | 'butter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|weight|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: orientation, weight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Rule> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:soft|hard|thick)$/]",
        "message": "<Rule> weight must be one of 'soft' | 'hard' | 'thick'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|size|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<StatBlock> size must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|children|style|key|ref|className|style|children)$/]",
        "message": "<StepCell> doesn't accept that prop. Declared props: n, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|rotate|width|style|key|ref|className|style|children)$/]",
        "message": "<StickyNote> doesn't accept that prop. Declared props: children, rotate, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|mono|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, icon, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper|wash|rust|outline|glass)$/]",
        "message": "<Tag> tone must be one of 'ink' | 'paper' | 'wash' | 'rust' | 'outline' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|location|rating|verified|tone|style|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, name, location, rating, verified, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|sage|peach|lilac|butter)$/]",
        "message": "<TestimonialCard> tone must be one of 'blue' | 'sage' | 'peach' | 'lilac' | 'butter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|boxed|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: variant, size, boxed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark|condensed)$/]",
        "message": "<Wordmark> variant must be one of 'lockup' | 'mark' | 'condensed'."
      }
    ]
  },
  "overrides": [
