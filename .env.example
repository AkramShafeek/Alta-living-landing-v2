# ─────────────────────────────────────────────────────────────────────────
# Database sources.
#
# Each table reads from its own source, so the sheet can take over the catalog
# one tab at a time. Unset tables fall back to VITE_DB_SOURCE, which defaults
# to "mock" — so this file being absent means "everything from fixtures", which
# is what a fresh clone and every CI run should get.
#
# Values: mock | sheets
# ─────────────────────────────────────────────────────────────────────────

# The 2PACX id from File > Share > Publish to web.
# NOT the spreadsheet id in the editing URL — that one is for the Sheets API.
VITE_SHEET_PUB_ID=

# Default for any table without its own switch below.
VITE_DB_SOURCE=mock

VITE_DB_SOURCE_PROPERTIES=mock
VITE_DB_SOURCE_UNITS=mock
VITE_DB_SOURCE_PHOTOS=mock
VITE_DB_SOURCE_REVIEWS=mock
VITE_DB_SOURCE_NEARBY=mock
VITE_DB_SOURCE_AMENITIES=mock
VITE_DB_SOURCE_INCLUDED=mock
VITE_DB_SOURCE_HOUSEKEEPING=mock
VITE_DB_SOURCE_NOT_INCLUDED=mock
VITE_DB_SOURCE_HIGHLIGHTS=mock

# `hosts` has no switch on purpose. It holds phone/whatsapp for a real person
# and publish-to-web is world-readable, so it stays a fixture until there is
# somewhere authenticated to put it.
