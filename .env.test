# Test env. Vitest runs in mode "test", so this file wins over .env.
#
# Every table is pinned to its fixture. Without this the suite inherits .env,
# which points `properties` and `units` at the published sheet — so `npm test`
# would hit the network, assert against data ops can edit, and fail on a plane.
# A test that reads production is not a test.
#
# Every switch is listed explicitly: Vite merges .env.test over .env key by key,
# so a per-table switch left out here keeps whatever .env said. Setting only
# VITE_DB_SOURCE is not enough.
#
# To exercise the sheets driver deliberately, set the switch inside that test.

VITE_SHEET_PUB_ID=
VITE_DB_SOURCE=mock

VITE_DB_SOURCE_PROPERTIES=mock
VITE_DB_SOURCE_UNITS=mock
VITE_DB_SOURCE_PHOTOS=mock
VITE_DB_SOURCE_REVIEWS=mock
VITE_DB_SOURCE_NEARBY=mock
VITE_DB_SOURCE_AMENITIES=mock
VITE_DB_SOURCE_INCLUDED=mock
VITE_DB_SOURCE_NOT_INCLUDED=mock
VITE_DB_SOURCE_HOUSEKEEPING=mock
VITE_DB_SOURCE_HIGHLIGHTS=mock
